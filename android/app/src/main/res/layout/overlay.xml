<?xml version="1.0" encoding="utf-8"?>
<!--
  Single overlay for both orientations.
  Portrait (as declared here): control panel docked at the bottom.
  Landscape: MainActivity applies a ConstraintSet that docks the panel to the right.
  The video (GLSurfaceView) sits underneath this layout, full-screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Status badge: top-left, small, unobtrusive -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:text="@string/status_no_camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FPS badge: next to status; hidden until streaming -->
    <TextView
        android:id="@+id/tv_fps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/text_ok"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="0.0 fps"
        app:layout_constraintStart_toEndOf="@id/tv_status"
        app:layout_constraintTop_toTopOf="@id/tv_status"
        app:layout_constraintBottom_toBottomOf="@id/tv_status" />

    <!-- Recording badge: next to fps; visible only while recording -->
    <TextView
        android:id="@+id/tv_rec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_badge_rec"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="● 00:00"
        app:layout_constraintStart_toEndOf="@id/tv_fps"
        app:layout_constraintTop_toTopOf="@id/tv_status"
        app:layout_constraintBottom_toBottomOf="@id/tv_status" />

    <!-- Update available: tap opens the update dialog. Hidden unless a newer release exists. -->
    <TextView
        android:id="@+id/tv_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_badge"
        android:drawableStart="@drawable/ic_update"
        android:drawablePadding="6dp"
        android:drawableTint="@color/accent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_status"
        app:layout_constraintTop_toBottomOf="@id/tv_status" />

    <!-- Centre prompt + Connect: visible only when no camera -->
    <LinearLayout
        android:id="@+id/group_no_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:text="@string/status_no_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            android:text="@string/btn_connect" />
    </LinearLayout>

    <!-- White-balance slider: slides out above the panel when toggled -->
    <LinearLayout
        android:id="@+id/panel_wb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel_controls">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="❄" />

        <SeekBar
            android:id="@+id/sb_warmth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="☀" />
    </LinearLayout>

    <!-- Control panel: Photo/Video toggle / [Shutter] / Gallery. Everything else is in the menu (top right). -->
    <LinearLayout
        android:id="@+id/panel_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_panel"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">



        <!-- Flip / rotate: shown only when the panel has room (big screens); always in the menu -->
        <ImageButton
            android:id="@+id/btn_flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_round"
            android:src="@drawable/ic_flip"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_flip" />

        <ImageButton
            android:id="@+id/btn_rotate"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_round"
            android:src="@drawable/ic_rotate"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_rotate" />

        <!-- Photo / video mode toggle: decides what the shutter and the cable button do -->
        <ImageButton
            android:id="@+id/btn_mode"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_round"
            android:src="@drawable/ic_mode_video"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_mode" />

        <ImageButton
            android:id="@+id/btn_photo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/bg_btn_shutter"
            android:src="@drawable/ic_photo"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_photo" />

        <!-- Gallery: round thumbnail of the last shot -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_gallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_round"
            android:padding="1dp"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_gallery"
            app:shapeAppearanceOverlay="@style/ShapeCircle"
            app:strokeColor="#99FFFFFF"
            app:strokeWidth="1.5dp" />



    </LinearLayout>

    

    <!-- Log toggle: top-right -->
    <ImageButton
        android:id="@+id/btn_log"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_badge"
        android:src="@drawable/ic_log"
        android:scaleType="centerInside"
        android:contentDescription="Log"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Log panel: overlays the picture, toggled by btn_log -->
    <ScrollView
        android:id="@+id/panel_log"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_panel"
        android:fadeScrollbars="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_log"
        app:layout_constraintHeight_percent="0.45">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#D0FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
